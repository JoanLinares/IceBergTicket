# =============================================================================
# IceBergTicket — Configuración de Entorno Local (Docker / Standalone)
# =============================================================================

# Base de datos PostgreSQL local
# Para Docker compose:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/icebergticket
# Para ejecutar 'uv run python app.py' directamente en tu máquina host:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/icebergticket

# MinIO Local (100% gratuito y auto-hospedado)
# Para Docker compose:
MINIO_ENDPOINT=minio:9000
# Para ejecutar en host contra MinIO en Docker:
# MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=iceberg-tickets
MINIO_USE_SSL=false

# Claves criptográficas y de seguridad (valores de desarrollo local)
MASTER_KEY_V1=rZ7P4Z4O1xJ9V2v7X8k0W5m3N6q9S2u5Y8b1E4g7H0c=
SECRET_KEY=dev-secret-local-minio-postgres
JWT_SECRET=dev-jwt-secret-local
PORT=5000
